<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="bimanual_panda">
<xacro:include filename="$(find franka_description)/robots/panda_arm.xacro"/>
<xacro:include filename="$(find franka_description)/robots/utils.xacro"/>
<xacro:include filename="$(find allegro_hand_description)/allegro_hand_description_3F.urdf"/>

<link name="base">
<visual>
<origin xyz="0 0 0.5" rpy="0 0 0"/>
<geometry>
<box size="1 2 1" />
</geometry>
</visual>
<collision>
<origin xyz="0 0 0.5" rpy="0 0 0"/>
<geometry>
<box size="1 2 1" />
</geometry>
</collision>
</link>

<!--Left Arm-->

<xacro:panda_arm arm_id="left" connected_to="base" xyz="0 0.5 1" safety_distance="0.03" gazebo="true"/>

<xacro:gazebo-joint joint="left_joint1" transmission="hardware_interface/PositionJointInterface" />
<xacro:gazebo-joint joint="left_joint2" transmission="hardware_interface/PositionJointInterface" />
<xacro:gazebo-joint joint="left_joint3" transmission="hardware_interface/PositionJointInterface" />
<xacro:gazebo-joint joint="left_joint4" transmission="hardware_interface/PositionJointInterface" />
<xacro:gazebo-joint joint="left_joint5" transmission="hardware_interface/PositionJointInterface" />
<xacro:gazebo-joint joint="left_joint6" transmission="hardware_interface/PositionJointInterface" />
<xacro:gazebo-joint joint="left_joint7" transmission="hardware_interface/PositionJointInterface" />

<xacro:gazebo-joint joint="left_joint1" transmission="hardware_interface/VelocityJointInterface" />
<xacro:gazebo-joint joint="left_joint2" transmission="hardware_interface/VelocityJointInterface" />
<xacro:gazebo-joint joint="left_joint3" transmission="hardware_interface/VelocityJointInterface" />
<xacro:gazebo-joint joint="left_joint4" transmission="hardware_interface/VelocityJointInterface" />
<xacro:gazebo-joint joint="left_joint5" transmission="hardware_interface/VelocityJointInterface" />
<xacro:gazebo-joint joint="left_joint6" transmission="hardware_interface/VelocityJointInterface" />
<xacro:gazebo-joint joint="left_joint7" transmission="hardware_interface/VelocityJointInterface" />

<xacro:gazebo-joint joint="left_joint1" transmission="hardware_interface/EffortJointInterface" />
<xacro:gazebo-joint joint="left_joint2" transmission="hardware_interface/EffortJointInterface" />
<xacro:gazebo-joint joint="left_joint3" transmission="hardware_interface/EffortJointInterface" />
<xacro:gazebo-joint joint="left_joint4" transmission="hardware_interface/EffortJointInterface" />
<xacro:gazebo-joint joint="left_joint5" transmission="hardware_interface/EffortJointInterface" />
<xacro:gazebo-joint joint="left_joint6" transmission="hardware_interface/EffortJointInterface" />
<xacro:gazebo-joint joint="left_joint7" transmission="hardware_interface/EffortJointInterface" />

<xacro:transmission-franka-state arm_id="left" />
<xacro:transmission-franka-model arm_id="left" root="left_joint1" tip="left_joint8" />

<!--Left Hand-->
<xacro:gazebo-joint joint="joint_0_0" transmission="hardware_interface/PositionJointInterface"/>
<xacro:gazebo-joint joint="joint_1_0" transmission="hardware_interface/PositionJointInterface"/>
<xacro:gazebo-joint joint="joint_2_0" transmission="hardware_interface/PositionJointInterface"/>
<xacro:gazebo-joint joint="joint_3_0" transmission="hardware_interface/PositionJointInterface"/>
<xacro:gazebo-joint joint="joint_4_0" transmission="hardware_interface/PositionJointInterface"/>
<xacro:gazebo-joint joint="joint_5_0" transmission="hardware_interface/PositionJointInterface"/>
<xacro:gazebo-joint joint="joint_6_0" transmission="hardware_interface/PositionJointInterface"/>
<xacro:gazebo-joint joint="joint_7_0" transmission="hardware_interface/PositionJointInterface"/>
<xacro:gazebo-joint joint="joint_8_0" transmission="hardware_interface/PositionJointInterface"/>

<!--Right Hand-->

<xacro:panda_arm arm_id="right" connected_to="base" xyz="0 -0.5 1" safety_distance="0.03" gazebo="true"/>

<xacro:gazebo-joint joint="right_joint1" transmission="hardware_interface/PositionJointInterface" />
<xacro:gazebo-joint joint="right_joint2" transmission="hardware_interface/PositionJointInterface" />
<xacro:gazebo-joint joint="right_joint3" transmission="hardware_interface/PositionJointInterface" />
<xacro:gazebo-joint joint="right_joint4" transmission="hardware_interface/PositionJointInterface" />
<xacro:gazebo-joint joint="right_joint5" transmission="hardware_interface/PositionJointInterface" />
<xacro:gazebo-joint joint="right_joint6" transmission="hardware_interface/PositionJointInterface" />
<xacro:gazebo-joint joint="right_joint7" transmission="hardware_interface/PositionJointInterface" />

<xacro:gazebo-joint joint="right_joint1" transmission="hardware_interface/VelocityJointInterface" />
<xacro:gazebo-joint joint="right_joint2" transmission="hardware_interface/VelocityJointInterface" />
<xacro:gazebo-joint joint="right_joint3" transmission="hardware_interface/VelocityJointInterface" />
<xacro:gazebo-joint joint="right_joint4" transmission="hardware_interface/VelocityJointInterface" />
<xacro:gazebo-joint joint="right_joint5" transmission="hardware_interface/VelocityJointInterface" />
<xacro:gazebo-joint joint="right_joint6" transmission="hardware_interface/VelocityJointInterface" />
<xacro:gazebo-joint joint="right_joint7" transmission="hardware_interface/VelocityJointInterface" />

<xacro:gazebo-joint joint="right_joint1" transmission="hardware_interface/EffortJointInterface" />
<xacro:gazebo-joint joint="right_joint2" transmission="hardware_interface/EffortJointInterface" />
<xacro:gazebo-joint joint="right_joint3" transmission="hardware_interface/EffortJointInterface" />
<xacro:gazebo-joint joint="right_joint4" transmission="hardware_interface/EffortJointInterface" />
<xacro:gazebo-joint joint="right_joint5" transmission="hardware_interface/EffortJointInterface" />
<xacro:gazebo-joint joint="right_joint6" transmission="hardware_interface/EffortJointInterface" />
<xacro:gazebo-joint joint="right_joint7" transmission="hardware_interface/EffortJointInterface" />

<xacro:transmission-franka-state arm_id="right" />
<xacro:transmission-franka-model arm_id="right" root="right_joint1" tip="right_joint8" />

</robot>
