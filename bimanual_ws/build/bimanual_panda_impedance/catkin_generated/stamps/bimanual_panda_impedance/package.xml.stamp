<?xml version="1.0"?>
<package format="2">

  <name>bimanual_panda_impedance</name>
  <version>0.1.0</version>

  <description>
    Combined left and right Panda control using the provided
    DualArmCartesianImpedanceExampleController.
  </description>

  <maintainer email="ntluan.ut@gmail.com">
    Nguyen Thanh Luan
  </maintainer>

  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>franka_msgs</exec_depend>
  <exec_depend>franka_control</exec_depend>
  <exec_depend>franka_example_controllers</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>dynamic_reconfigure</exec_depend>

</package>
